# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
GEMINI_MODEL=gemini-3.5-flash
PORT=3000

# RECOMMENDED for free live + cited reports:
# Tavily is a free AI search API (1,000 searches/month, no credit card).
# Get a key at https://app.tavily.com and paste it below. When set, the app
# uses Tavily for live web research + real source URLs — no Google billing needed.
TAVILY_API_KEY=

# Gemini's own Google Search grounding (needs Google billing on your project).
# Only used if TAVILY_API_KEY is empty. Set false to skip it and use model
# knowledge instead.
ENABLE_GROUNDING=true
